# Copy to .env and fill in. .env is gitignored and never copied into Docker images.
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: which experiment config the app/CLI uses by default.
# The Cloud Run image sets configs/prod.yaml and REGNAV_PUBLIC_DEMO=1.
# Compose overrides the demo flag to 0.
REGNAV_CONFIG=configs/hybrid_stratified.yaml
# REGNAV_PUBLIC_DEMO=0
# APP_PASSWORD=
# MAX_QUESTIONS_PER_SESSION=20
# PORT=8501
# Optional on a laptop (in this cloud environment the key is injected by the network proxy):
GROQ_API_KEY=
# Free-tier Gemini Flash fallback for the public demo (configs/prod.yaml).
GEMINI_API_KEY=
